# Run opam with the given arguments. On Windows, opam ends its lines with \r\n, which breaks scripts
# that read its output: drop the \r unless the output goes to a terminal.

if [ -t 1 ]; then
  exec opam "$@"
fi
set -o pipefail
opam "$@" | tr -d '\r'
